# deep_layers — environment configuration example
#
# Copy to a local dotenv file and uncomment only the variables you want to
# override. Every variable is OPTIONAL: scripts/config.py (Settings) ships
# sensible defaults, shown here as the commented value. The local dotenv file
# is never committed.

# --- Data & output directories -------------------------------------------
# Paths are resolved relative to the current working directory when set here;
# leave commented to use the repo-relative defaults.
# IR_DIR=data/ir
# RGB_DIR=data/rgb
# MODELS_DIR=models
# LOGS_DIR=logs

# --- Pipeline ------------------------------------------------------------
# PATCH_MULTIPLE=16        # pad H/W to the nearest multiple of this
# BATCH_SIZE=8             # small batch is why every model uses GroupNorm
# LEARNING_RATE=0.0001     # initial Adam learning rate
# EPOCHS=100               # max epochs (EarlyStopping usually stops sooner)
# SEED=42                  # global RNG seed for reproducibility

# --- Data split ----------------------------------------------------------
# Real artworks are always grouped by ID so no section of a painting leaks
# across folds; test = 1 - TRAIN_RATIO - VAL_RATIO.
# TRAIN_RATIO=0.70
# VAL_RATIO=0.15
# MOCKUP_ARTWORK_IDS=["tblu","tbianco","tbruno","tgiallo","trosso","tverde"]
# MOCKUP_TEST_RATIO=0.05   # mockups are split at the pair level, not grouped

# --- Cross-validation (scripts/kfold.py) ---------------------------------
# KFOLD_K=3
# KFOLD_SEED=42            # kept separate from SEED so folds are independent

# --- Deterministic loss --------------------------------------------------
# combined_loss = LOSS_ALPHA * Charbonnier + (1 - LOSS_ALPHA) * (1 - MS-SSIM),
# used by EVERY deterministic architecture. The default weights MS-SSIM at 84%
# (the "Mix" configuration of Zhao et al. 2016). Raising LOSS_ALPHA trades
# structure for pixel fidelity and is known to destabilise some architectures —
# see architectures.md §12 before changing it.
# LOSS_ALPHA=0.16          # weight of the Charbonnier term
# CHARBONNIER_EPS=0.001    # smoothing epsilon; ~0.25 grey levels out of 255

# --- Heteroscedastic loss ------------------------------------------------
# laplace_nll_loss, the default for every *_nll architecture. The second output
# channel is a Laplace LOG-SCALE (log b), not a log-variance — NLL_LOG_VAR_* are
# historical names. sigma = b * sqrt(2).
# NLL_BETA=0.5             # beta-NLL gradient reweighting (Seitzer et al.)
# NLL_LOG_VAR_MIN=-6.0     # numerical guard on log b, not an activation
# NLL_LOG_VAR_MAX=6.0

# --- Optimiser -----------------------------------------------------------
# WEIGHT_DECAY=0.00001
# GRADIENT_CLIP_VALUE=1.0  # per-element clip; guards the MS-SSIM gradient

# --- Callbacks -----------------------------------------------------------
# EARLY_STOPPING_PATIENCE=20
# EARLY_STOPPING_MIN_DELTA=0.0005   # not 0.0: see the Settings docstring
# EARLY_STOPPING_RESTORE_BEST_WEIGHTS=false
# REDUCE_LR_FACTOR=0.25
# REDUCE_LR_PATIENCE=6
# REDUCE_LR_COOLDOWN=2
# REDUCE_LR_MIN_DELTA=0.0001
# REDUCE_LR_MIN_LR=0.000001

# --- Two-phase EfficientNet fine-tuning (*_ft checkpoints) ---------------
# FINETUNE_LEARNING_RATE=0.00001    # 10x below LEARNING_RATE
# FINETUNE_EPOCHS=20

# --- Dilated (ASPP) bottleneck -------------------------------------------
# Used by unet_dilated / unet_v2_dilated only.
# DILATION_RATES=[1,2,4,8]

# --- combined_loss_advanced (NOT wired to any training path) -------------
# Implemented and tested, but no architecture trains with it. Opting in means
# editing scripts/trainer.py. Weights should sum to 1.
# ADV_LOSS_ALPHA=0.5       # MAE term
# ADV_LOSS_BETA=0.3        # Laplacian pyramid term
# ADV_LOSS_GAMMA=0.2       # FFT magnitude term
# LAPLACIAN_LEVELS=4

# --- Training augmentation ------------------------------------------------
# Paired random crop, applied ONLY to the training split. Must be a multiple
# of 16. Leave unset to disable cropping (default).
# CROP_SIZE=256
